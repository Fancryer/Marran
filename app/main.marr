row Mutation = {Var; Cell; Read; Rebind}
row Io = {Input; Output}
row Main = {... Mutation; ... Io | `R}

funct apply (f `A -> `R `B) (x `A) : `R `B = f x



/|
funct guess_game () : {Input; Output; Random} () =
  val secret = random_int 1 100;
  var attempts = 0;
  var guessed = false;
  
  sayn 'Guess the number (1-100)';
  while {not guessed}
  {
    sayn 'Enter your guess:';
    val guess = read_int ();
    attempts := + 1 attempts;
    if eq guess secret then (
      guessed := true;
      say 'Correct! You took '; say attempts; sayn ' attempts.'
    )
    else if lt guess secret then
      sayn 'Too low!'
    else
    sayn 'Too high!'
  }
|\

funct while
  (pred () -> Main Boolean)
  (do () -> Main ())
  : Main ()
  = if pred () then while pred do else ()

funct guess_game () : Main () =
  var i = 10;
  force $ while {/|> i 0|\i; false} {
    say 'i: '; sayn i;
    i := - i 1;
    ()
  }

funct main () : Main () = apply + 3 2

