module Main
import @native

//| Пустой массив — [Nothing], а Nothing — нижний тип: `[[1], []]` и
//| `[[], [1]]` типизируются одинаково, в каком бы порядке ни стояли.
//| Ожидается вывод:
//| [[1], []]
//| [[], [1]]
//| []
funct main () : {Output} () =
  sayn [[1], []];
  sayn [[], [1]];
  val empty : [Int] = [];
  sayn empty
