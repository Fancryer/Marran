//| Читает числа, пока не встретит 5, и возвращает 7; если 5 так и не
//| встретилось, после десяти итераций возвращает or_else (0).
//| `break : `T -> `T`, поэтому `break 7` стоит прямо в ветке `if`,
//| без `(break 7; ...)`. Тело `under` обработчик приводит к WHNF сам,
//| поэтому `force` вокруг `if` не нужен.
row Mutation = {Var; Cell; Read; Rebind}
row Io = {Input; Output}
row Main = {... Mutation; ... Io | `R}

effect Loop[T]
  continue : () -> ();
  break : `T -> `T
end

funct loop[T]
  (pred () -> Main Boolean)
  (do () -> {Loop[`T]; ... Main} `T)
  (or_else `T)
  : Main `T
  =
    under Loop[`T] to
      if pred () then (do (); loop pred do or_else) else or_else
    handle
    | break x => x
    | continue c => (do (); loop pred do or_else)

funct main () : Main () =
  var x = 0;
  sayn $ loop {< x 10}
  {
    val y = read_int ();
    if ieq y 5 then
      break 7
    else
      (x := + x 1; x)
  } 0
