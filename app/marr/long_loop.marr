//| Сборка мусора: куча — это куча Haskell, поэтому построенная и забытая
//| структура освобождается, а длинный хвостовой цикл не упирается в память.
//| Раньше тысячи записей оставались в таблице навсегда, а две тысячи шагов
//| цикла падали на `VirtualAlloc`.
//| Ожидается вывод: 30000, 0, 300000
funct step (i Int) (acc Int) : Int =
  if ieq i 0 then acc else step (pred i) (+ acc 1)

funct burn (i Int) : Int =
  if ieq i 0 then 0 else
    let garbage = #{ val left = i; val right = - i 1 } in
    if ieq garbage@left 0 then 0 else burn (pred i)

funct main () : {Output} () =
  sayn (step 30000 0);
  sayn (burn 30000);
  sayn (step 300000 0)
