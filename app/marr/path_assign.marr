module Main

//| Присваивание по пути: `r@a := ...`. Правая часть отложена и видит старое
//| значение поля, а промежуточные записи пути читаются (их `var`-поля — за Read).
//| Ожидается: 2, 10, 21
funct main () : {Output; Var; Cell; Rebind; Read} () =
  var r = #{ var a = 1; val b = 10; var n = #{ var c = 20 } };
  r@a := + r@a 1;
  sayn r@a;
  sayn r@b;
  r@n@c := + r@n@c 1;
  sayn r@n@c
