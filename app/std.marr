val Functions = #{
  val id      : `T -> `T = ...;
  val const   : `A -> `B -> `A = ...;
  val flip    : (`A -> `B -> `C) -> `B -> `A -> `C = ...;
  val compose : (`B -> `R `C) -> (`A -> `R `B) -> `A -> `C = ...;
  val apply   : (`A -> `R `B) -> `A -> `R `B = ...;
  val curry   : ((`A, `B) -> `R `C) -> `A -> `B -> `R `C = ...;
  val uncurry : (`A -> `B -> `R `C) -> (`A,  `B) -> `R `C = ...
}

val Numbers = #{
  //| everything is also implicitly imported to native scope (above global)
  val +         : Int -> Int -> Int = ...;
  val -         : Int -> Int -> Int = ...;
  val *         : Int -> Int -> Int = ...;
  val /         : Int -> Int -> {Error} Int = ...;
  val %         : Int -> Int -> Int = ...;
  val neg       : Int -> Int = ...;
  val abs       : Int -> Int = ...;
  val max       : Int -> Int -> Int = ...;
  val min       : Int -> Int -> Int = ...;
  val ieq       : Int -> Int -> Boolean = ...;
  val ineq      : Int -> Int -> Boolean = ...;
  val <         : Int -> Int -> Boolean = ...;
  val >         : Int -> Int -> Boolean = ...;
  val <=        : Int -> Int -> Boolean = ...;
  val >=        : Int -> Int -> Boolean = ...;
  //| floats
  val +.        : Float -> Float -> Float = ...;
  val -.        : Float -> Float -> Float = ...;
  val *.        : Float -> Float -> Float = ...;
  val /.        : Float -> Float -> Float = ...;
  val %.        : Float -> Float -> Float = ...;
  val fneg      : Float -> Float = ...;
  val fabs      : Float -> Float = ...;
  val fmax      : Float -> Float -> Float = ...;
  val fmin      : Float -> Float -> Float = ...;
  val feq       : Float -> Float -> Boolean = ...;
  val fneq      : Float -> Float -> Boolean = ...;
  val <.        : Float -> Float -> Boolean = ...;
  val >.        : Float -> Float -> Boolean = ...;
  val <=.       : Float -> Float -> Boolean = ...;
  val >=.       : Float -> Float -> Boolean = ...;
  //| conversions
  val to_int    : Float -> Int = ...;
  val to_float  : Int -> Float = ...
}

val Strings = #{
  val ++        : String -> String -> String = ...;
  val slen      : String -> Int = ...;
  val sub       : Int -> Int -> String = ...;
  val split     : String -> String -> [String] = ...;
  val join      : String -> [String] -> String = ...;
  val trim      : String -> String = ...;
  val upper     : String -> String = ...;
  val lower     : String -> String = ...;
  val contains  : String -> String -> Boolean = ...;
  val replace   : String -> String -> String -> String = ...;
  val seq       : String -> String -> Boolean = ...;
  val sneq      : String -> String -> Boolean = ...
}

val Booleans = #{
  val not   : Boolean -> Boolean = ...;
  val ||    : Boolean -> Boolean -> Boolean = ...;
  val &&    : Boolean -> Boolean -> Boolean = ...;
  val ^     : Boolean -> Boolean -> Boolean = ...;
  val nor   : Boolean -> Boolean -> Boolean = ...;
  val nand  : Boolean -> Boolean -> Boolean = ...
}

val Arrays = #{
  val head    : [`T] -> `T = ...;
  val tail    : [`T] -> [`T] = ...;
  val empty   : [`T] -> Boolean = ...;
  val alen    : [`T] -> Int = ...;
  val map     : (`A -> `R `B) -> [`A] -> `R [`B] = ...;
  //| the predicate takes one element, not the whole array
  val filter  : (`T -> `R Boolean) -> [`T] -> `R [`T] = ...;
  val any     : (`T -> `R Boolean) -> [`T] -> `R Boolean = ...;
  val all     : (`T -> `R Boolean) -> [`T] -> `R Boolean = ...;
  val foldl   : (`B -> `A -> `R `B) -> `B -> [`A] -> `R `B = ...;
  val foldr   : (`B -> `A -> `R `B) -> `B -> [`A] -> `R `B = ...;
  val concat  : [[`T]] -> [`T] = ...;
  val zip     : [`A] -> [`B] -> [`A, `B] = ...;
  val at      : [`T] -> Int -> {Error} `T = ...;
  val take    : Int -> [`T] -> [`T] = ...;
  val drop    : Int -> [`T] -> [`T] = ...
}

val Pairs = #{
  val fst : (`L, `R) -> `L = ...;
  val snd : (`L, `R) -> `R = ...
}

val Output = #{
  val say   : `A -> {Output} () = ...;
  val sayn  : `A -> {Output} () = ...;
  val trace : String -> `A -> {Output} `A = ...
}


val Input = #{
  val read_int    : () -> {Input; Error} Int = ...;
  val read_string : () -> {Input; Error} String = ...;
  val read_float  : () -> {Input; Error} Float = ...
}

effect Env
  get_env  : String -> {Env} String;
  set_env  : String -> String -> {Env} ()
end

effect File
  read_file       : String -> {File; Error} String;
  write_file      : String -> String -> {File; Error} ();
  append_file     : String -> String -> {File; Error} ();
  file_exists     : String -> {File} Boolean;
  delete_file     : String -> {File; Error} ();
  list_directory  : String -> {File; Error} [String]
end

effect Random
  random_int      : Int -> Int -> {Random} Int;
  random_float    : () -> {Random} Float;
  random_boolean  : () -> {Random} Boolean;
  random_string   : Int -> {Random} String
end

effect Time
  time_ms : () -> {Time} Int;
  sleep   : Int -> {Time} ()
end

effect System
  args      : () -> {System} [String];
  hostname  : () -> {System} String;
  system    : String -> {System} Int;
  exit      : Int -> {System} Nothing
end


val Conv = #{
  val show  : `T -> String = ...;
  //| TODO: `String -> {Error} `T` cannot be implemented yet.  The interpreter
  //| erases types, so the function has no way to know which type to build; a
  //| real `parse` needs the type annotation of the result (P1-4/P1-5).
  val parse : String -> {Error} `T = ...
}

effect Error
  error   : String -> {Error} `A
end

//| `try` and `assert` are functions, not operations of `Error`: `try` installs
//| a handler for `Error` itself, and `assert` reports a failed condition
//| through it.  Neither needs a clause in a handler the program writes, and
//| naming `try` does not charge `Error` -- only the body it runs may.
//|
//|   try    : (() -> {Error | `R} `A) -> (String -> `R `A) -> `R `A;
//|   assert : Boolean -> String -> {Error} ()